# Copy this file to secrets.properties (same folder) and fill in your values.
# secrets.properties is git-ignored, so your real keys never reach GitHub.
# Only uncomment lines you actually set: an empty value overrides the built-in default.

# JWT signing key: any random string of at least 32 characters
#JWT_SECRET=

# Database: leave commented to use the embedded H2 database. For MySQL, uncomment all four:
#DB_URL=jdbc:mysql://localhost:3306/invoice_db
#DB_DRIVER=com.mysql.cj.jdbc.Driver
#DB_USERNAME=root
#DB_PASSWORD=

# AI providers (optional; the rule-based fallback works without them)
#GEMINI_API_KEY=
#OPENAI_API_KEY=
